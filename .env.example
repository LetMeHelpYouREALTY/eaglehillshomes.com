# Copy to `.env.local` for local dev. Production: Vercel → Project → Settings → Environment Variables

# =============================================================================
# Google Search Console (required for ownership verification)
# =============================================================================
# Preferred property: https://www.eaglehillshomes.com (URL prefix)
# After deploy, submit sitemap: https://www.eaglehillshomes.com/sitemap.xml
#
# HTML tag method — paste ONLY the content= value from GSC (not the whole tag):
GOOGLE_SITE_VERIFICATION=
# Public alias (also read by lib/seo.ts):
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Bing Webmaster Tools token:
# BING_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# HTML file method (alternative): drop googleXXXXXXXX.html in /public/
# See public/google-site-verification.README.txt

# =============================================================================
# Local SEO / widgets
# =============================================================================

# Google Business Profile URL (footer + JSON-LD sameAs)
NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=

# RealScout agent-encoded-id (default QWdlbnQtMjI1MDUw)
NEXT_PUBLIC_REALSCOUT_AGENT_ID=

# Calendly event URL (default https://calendly.com/drjanduffy/showing)
NEXT_PUBLIC_CALENDLY_URL=
